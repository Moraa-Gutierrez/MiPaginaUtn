PORT=3000
MONGO_URI="mongodb://localhost:27017/M&L"
STORAGE=supabase
# IMPORTANTE: SUPABASE_URL debe ser la URL raíz del proyecto (sin /rest/v1/)
SUPABASE_URL="https://tu-proyecto.supabase.co"
# Para backend, se recomienda la service_role key (bypasses RLS) o la anon key con políticas RLS
SUPABASE_KEY="tu_supabase_service_role_o_anon_key"
CARPETA_IMAGENES="CARPETA_IMAGENES"